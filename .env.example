# Copy to .dev.vars in the project root (the folder containing package.json).
# It is for Cloudflare Pages Functions development only; never commit secrets.
# Use plain KEY=value lines: do not add trailing backslashes or escape http://.
# For admin preview locally only: local browser uses X-Local-Admin-Key matching LOCAL_ADMIN_TOKEN.
ENVIRONMENT=development
LOCAL_ADMIN_TOKEN=choose-a-long-random-token-only-for-local-development
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
# Optional production-only admin password mode. Configure these as Cloudflare
# Pages secrets after following SETUP_GUIDE.md section 8.3A; never put real
# production values in .dev.vars, Git, or a VITE_ variable.
ADMIN_AUTH_MODE=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
BREVO_API_KEY=
BREVO_LIST_ID=
MAIL_FROM=
SITE_ORIGIN=http://localhost:8788
# Facebook Page ID and publication controls are saved in the protected admin
# dashboard. For local manual sync only, add a temporary token here; production
# uses the FB_PAGE_ACCESS_TOKEN Cloudflare secret instead.
FB_PAGE_ACCESS_TOKEN=
